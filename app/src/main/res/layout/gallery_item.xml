<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"

    android:layout_height="wrap_content">



    <ImageView

        android:id="@+id/gallery_iv_image"

        android:layout_width="match_parent"

        android:layout_height="124dp"

        android:background="@color/light_gray"

        android:scaleType="centerCrop" />



    <com.facebook.shimmer.ShimmerFrameLayout

        android:id="@+id/shimmer_layout"

        android:layout_width="match_parent"

        android:layout_height="124dp"

        app:shimmer_base_color="#EAEAEA"

        app:shimmer_duration="800"

        app:shimmer_highlight_color="#F5F5F5">



        <View

            android:layout_width="match_parent"

            android:layout_height="match_parent"

            android:background="#EAEAEA" />

    </com.facebook.shimmer.ShimmerFrameLayout>



    <View

        android:id="@+id/selected_overlay"

        android:layout_width="match_parent"

        android:layout_height="124dp"

        android:background="#400096FF"

        android:visibility="gone" />



    <TextView

        android:id="@+id/selection_badge"

        android:layout_width="24dp"

        android:layout_height="24dp"

        android:layout_gravity="top|end"

        android:layout_margin="8dp"

        android:background="@drawable/gallery_selected_overlay"

        android:gravity="center"

        android:textColor="@color/white"

        android:textSize="12sp"

        android:textStyle="bold"

        android:visibility="gone" />



</FrameLayout>

