<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgetPassword_fragment_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7F000000"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/auth_scrim"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="bottom"
            android:minHeight="80dp"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"

                android:paddingVertical="16dp">

                <TextView
                    android:id="@+id/tv_forgetPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/sacrifice_demo"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="@string/auth_forgot_header"
                    android:textColor="@color/white"
                    android:textSize="26sp" />
            </RelativeLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/forget_sheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_sheet_round"
            android:clickable="true"
            android:focusable="true"
            android:layout_below="@id/auth_scrim"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="25dp"

            android:paddingBottom="100dp">

            <View
                android:id="@+id/auth_sheet_handle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/auth_sheet_handle" />
            <TextView
                android:id="@+id/noteCodeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/ultra_regular"
                android:gravity="center"
                android:textColor="@color/ig_blue"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/forget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/poppins_medium"
                android:textStyle="bold"
                android:text="@string/auth_forgot_subtitle"
                android:textColor="#B6000000"
                android:textSize="14sp" />



            <LinearLayout
                android:id="@+id/inputEmail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/checkEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/auth_input_background"
                    android:hint="@string/auth_hint_email"
                    android:importantForAutofill="yes"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/midnight_black"
                    android:textColorHint="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/inputEmail_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/emailCode_id"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/auth_input_background"
                    android:hint="@string/auth_forgot_hint_code"
                    android:inputType="number"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/midnight_black"
                    android:textColorHint="@color/gray"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/InputChangePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:background="@drawable/auth_input_background"
android:gravity="center"
                android:visibility="gone">

                <EditText
                    android:id="@+id/passwordChange_id"
                    android:layout_width="300dp"
                    android:layout_height="48dp"
                    android:autofillHints=""
                    android:hint="@string/auth_forgot_hint_new_password"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/midnight_black"
                    android:textColorHint="@color/gray"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/password_toggle_new_password"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_toggle_password"
                    android:padding="8dp"

                    android:scaleType="centerInside"
                    android:src="@drawable/ic_visibility_off" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/InputConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/auth_input_background"

                android:visibility="gone">

                <EditText
                    android:id="@+id/confirmPassword"
                    android:layout_width="300dp"
                    android:layout_height="48dp"
                    android:hint="@string/auth_forgot_hint_confirm_password"
                    android:importantForAutofill="yes"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"

                    android:paddingHorizontal="16dp"
                    android:textColor="@color/midnight_black"
                    android:textColorHint="@color/gray"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/password_toggle_confirm_password"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/auth_toggle_password"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_visibility_off" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/confirmId"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/auth_button_primary"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/auth_forgot_confirm"
                    android:textAllCaps="false"
                    android:layout_centerInParent="true"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/forget_progress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:indeterminateTint="@color/white"
                    android:visibility="gone" />
            </RelativeLayout>

            <TextView
                android:id="@+id/back_to_login"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="19dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/poppins_medium"
                android:paddingHorizontal="4dp"
                android:paddingVertical="6dp"
                android:text="@string/auth_back_to_login"
                android:textColor="@color/app_color"
                android:textSize="10sp" />
        </LinearLayout>
    </RelativeLayout>

</androidx.core.widget.NestedScrollView>
