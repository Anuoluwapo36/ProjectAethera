<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_background"
    android:paddingBottom="16dp">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.example.projectaethera.ui.widgets.ProfileCircleWidgets
            android:id="@+id/imageProfile"
            android:layout_width="44dp"
            android:layout_height="44dp" />

        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/imageProfile"
            android:text="username"
            android:textColor="@color/app_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/optionBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ellipsis_solid_full"
            android:clickable="true"
            android:contentDescription="@string/delete_post"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/post_media_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager_post_images"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:overScrollMode="never" />

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            app:shimmer_base_color="#F0F0F0"
            app:shimmer_duration="900"
            app:shimmer_highlight_color="#FAFAFA" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/post_media_container"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="-28dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <RelativeLayout
        android:id="@+id/reactionId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/post_media_container"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/like"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/heart_regular_full" />

        <TextView
            android:id="@+id/likeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/like"
            android:text="0"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/comment"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="24dp"
            android:layout_toEndOf="@id/likeCount"
            android:background="@drawable/comment_regular_full" />

        <TextView
            android:id="@+id/commentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/comment"
            android:text="0"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/reactionId"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:text="username"
        android:textColor="@color/app_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/user_name"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:paddingEnd="16dp"
        android:text="caption"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/caption"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:text="2h ago"
        android:textColor="@color/app_text_muted"
        android:textSize="12sp" />

</RelativeLayout>
