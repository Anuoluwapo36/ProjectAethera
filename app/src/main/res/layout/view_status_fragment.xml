<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/status_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/status_progress_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/status_view_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/back"
            android:padding="6dp"
            android:src="@drawable/x_solid_full"
            app:tint="@color/gray" />

        <com.example.projectaethera.ui.widgets.ProfileCircleWidgets
            android:id="@+id/status_view_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/status_view_username"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/gray"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_view_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/status_view_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/status_add"
            android:padding="6dp"
            android:src="@drawable/plus_solid_full"
            android:tint="@color/white"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/status_view_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/status_delete_title"
            android:padding="6dp"
            android:src="@drawable/x_solid_full"
            android:tint="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/status_view_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/status_view_like"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/status_like"
            android:padding="8dp"
            android:src="@drawable/heart_regular_full"
            app:tint="@color/gray" />

        <TextView
            android:id="@+id/status_view_like_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gray"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
